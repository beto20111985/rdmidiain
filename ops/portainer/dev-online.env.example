# =============================================================================
# RD Mídia Indoor — variáveis da stack DEV ONLINE (docker-compose.dev-online.yml) — AÇÃO 005
# Colar em Portainer → Stack → Environment variables. NÃO contém segredos: segredos
# ficam em arquivos dentro de RD_SECRETS_DIR (ops/dev/generate-secrets.sh).
# =============================================================================

# Identidade (= nome da stack no Portainer; prefixo das imagens/volumes e dos roteadores do Traefik)
RD_INSTANCE=rd-dev
RD_INSTANCE_SLUG=rd-dev

# Domínios (DNS apontado para a VPS; certificados emitidos pela borda compartilhada)
RD_PANEL_DOMAIN=dev.exemplo.invalid
RD_API_DOMAIN=api-dev.exemplo.invalid
RD_PLAYER_DOMAIN=player-dev.exemplo.invalid
# Origens do Web Player (https): domínio do player + origem virtual da casca Windows
RD_PLAYER_ALLOWED_ORIGINS=https://player-dev.exemplo.invalid,https://player.rd.local

# Borda compartilhada (ops/edge/docker-compose.edge.yml) — mesmos valores da stack rd-edge
RD_EDGE_NETWORK=rd-edge
# IP fixo do Traefik na rede da borda (RD_EDGE_TRAEFIK_IP da stack rd-edge), /32
RD_TRUSTED_PROXY_CIDR=10.250.0.2/32

# Diretórios no HOST (root, 0700). O Portainer precisa enxergá-los no MESMO caminho
# (montagem somente leitura de /opt/rd-midiaindoor/instancias no container do Portainer).
RD_SECRETS_DIR=/opt/rd-midiaindoor/instancias/rd-dev/secrets
RD_CONFIG_DIR=/opt/rd-midiaindoor/instancias/rd-dev/config

# Bootstrap — lido SÓ na 1ª inicialização (ops/README.md §4.3). false = aprovação ÚNICA.
RD_BOOTSTRAP_DUAL_MASTER_APPROVAL=false
RD_BOOTSTRAP_MASTER_EMAIL=master.dev@exemplo.invalid
RD_BOOTSTRAP_MASTER_NAME=Administrador Master (DEV)

# Portas SÓ em 127.0.0.1 do host (acesso por túnel SSH); únicas por instância na VPS
RD_GRAFANA_PORT=3005
RD_MAILPIT_PORT=8025

# Opcionais
RD_WORKER_CONCURRENCY=2
RD_BACKUP_AT=03:00
RD_BACKUP_OFFSITE_CMD=
RD_BACKUP_OFFSITE_REQUIRED=false
