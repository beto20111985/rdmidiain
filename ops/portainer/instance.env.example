# =============================================================================
# RD Mídia Indoor — variáveis de UMA instância (stack) de produção.
# Copiar para fora do repositório (ex.: /opt/rd-midiaindoor/instancias/<instancia>/instance.env)
# ou colar em Portainer → Stack → Environment variables. NÃO contém segredos:
# segredos ficam em arquivos dentro de RD_SECRETS_DIR (ver ops/README.md).
# =============================================================================

# Identidade da instância (= nome da stack no Portainer; usado no filtro de logs)
RD_INSTANCE=rd-exemplo
# Slug da instância no gateway de pagamento (webhook /api/v1/webhooks/cloudpaypag/<slug>)
RD_INSTANCE_SLUG=rd-exemplo

# Imagens (construídas por ops/release/build-images.sh)
RD_REGISTRY=rd-midiaindoor
RD_VERSION=0.0.0-exemplo

# Domínios (subdomínio por instância; HTTPS obrigatório)
RD_PANEL_DOMAIN=painel.exemplo.invalid
RD_PLAYER_DOMAIN=player.exemplo.invalid
# Origens aceitas para o Web Player (https obrigatório): domínio do player + origem
# virtual da casca Windows (WebView2)
RD_PLAYER_ALLOWED_ORIGINS=https://player.exemplo.invalid,https://player.rd.local

# Portas da borda: 1 instância por VPS → 80/443. Várias instâncias no mesmo host →
# portas internas (ex.: 127.0.0.1:18080 / 127.0.0.1:18443) + roteador SNI compartilhado.
RD_HTTP_BIND=80
RD_HTTPS_BIND=443

# Diretórios no HOST (fora do repositório; dono root, 0700). RD_SECRETS_DIR deve conter
# também manifest_signing_key (PEM); RD_CONFIG_DIR deve conter alertmanager.yml e
# player_release_public_keys.json (ver ops/README.md §10).
RD_SECRETS_DIR=/opt/rd-midiaindoor/instancias/rd-exemplo/secrets
RD_CONFIG_DIR=/opt/rd-midiaindoor/instancias/rd-exemplo/config

# ─── Bootstrap da instância (AÇÃO 003) — lido SÓ na 1ª inicialização ──────────
# Serviço one-shot `bootstrap` (python -m app.cli bootstrap-instance). Depois da 1ª
# inicialização o modo de aprovação vive no banco: alterar estas variáveis e reimplantar
# NÃO muda o modo nem o Master (a divergência só é sinalizada — alerta
# RDSecurityEnvDivergence). Mudança de modo: fluxo protegido do painel.
# Aprovação financeira: true = DUPLA (2 Admin Master, ex.: RD oficial ou white-label com
# dois sócios) | false = ÚNICA (white-label simples). Obrigatória na 1ª inicialização.
RD_BOOTSTRAP_DUAL_MASTER_APPROVAL=true
# Master primário (assento 1): e-mail REAL (domínios reservados/placeholder são recusados
# em produção); nasce com troca de senha obrigatória + TOTP + senha financeira no 1º acesso.
RD_BOOTSTRAP_MASTER_EMAIL=master@exemplo.invalid
RD_BOOTSTRAP_MASTER_NAME=Administrador Master
# Senha INICIAL: SOMENTE o arquivo ${RD_SECRETS_DIR}/bootstrap_master_password (gerado
# aleatório por ops/dev/generate-secrets.sh). NUNCA RD_BOOTSTRAP_MASTER_PASSWORD em texto
# (recusado). O nome RD_DUAL_MASTER_APPROVAL NÃO é lido (gera aviso).

# Banco
RD_DB_NAME=rdmidiaindoor
RD_DB_SUPERUSER=rd_super

# E-mail transacional e de alertas (provedor externo)
RD_SMTP_HOST=smtp.exemplo.invalid
RD_SMTP_PORT=587
RD_SMTP_USER=nao-responder@exemplo.invalid
RD_SMTP_FROM=RD Mídia Indoor <nao-responder@exemplo.invalid>

# Gateway de pagamento (credenciais em RD_SECRETS_DIR/cloudpaypag_*)
RD_CLOUDPAYPAG_BASE_URL=https://cloudpaypag.top
# Subconta CloudPayPag desta instância (white-label; dependência externa)
RD_CLOUDPAYPAG_SUBCONTA_ID=

# Backup: horário (America/Sao_Paulo) e cópia FORA da VPS (dependência externa)
RD_BACKUP_AT=03:00
RD_BACKUP_COUNT_ROWS=1
# Ex.: RD_BACKUP_OFFSITE_CMD=rclone --config /run/secrets/rclone_conf copy "$1" offsite:rd-backups/rd-exemplo/
RD_BACKUP_OFFSITE_CMD=

# Observabilidade
RD_SENTRY_DSN=
RD_GRAFANA_PORT=3005
RD_PROMETHEUS_RETENTION=15d
RD_PROMETHEUS_RETENTION_SIZE=5GB
RD_WORKER_CONCURRENCY=4
