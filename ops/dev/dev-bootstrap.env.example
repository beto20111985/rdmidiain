# =============================================================================
# RD Mídia Indoor — BOOTSTRAP DA INSTÂNCIA em DESENVOLVIMENTO (modelo versionado)
# -----------------------------------------------------------------------------
# Copie para ops/dev/dev-bootstrap.env (arquivo LOCAL: não versionado, fora de todas as
# imagens) e ajuste. NÃO contém segredo: a senha INICIAL do Master primário vem SOMENTE do
# Docker secret ./secrets/bootstrap_master_password (aleatório por instalação, criado por
# ops/dev/generate-secrets.(sh|ps1), nunca exibido; RD_BOOTSTRAP_MASTER_PASSWORD em texto
# é RECUSADO pelo bootstrap).
#
# Lido SOMENTE pelo serviço one-shot `bootstrap` (python -m app.cli bootstrap-instance) e
# SOMENTE na PRIMEIRA inicialização da instância. Depois disso o modo de aprovação vive no
# banco (histórico selado): mudar este arquivo e reiniciar NÃO altera o modo nem o Master —
# a divergência é apenas sinalizada (alerta RDSecurityEnvDivergence / auditoria). Mudança de
# modo só pelo fluxo protegido do painel (Configurações → Segurança da instância).
# Produção: as mesmas variáveis vêm do ambiente da stack (ops/portainer/instance.env.example).
# =============================================================================

# Aprovação financeira da instância na 1ª inicialização: true = DUPLA (2 Admin Master),
# false = ÚNICA. Obrigatória na 1ª inicialização (ausente ⇒ bootstrap sai com código 2).
RD_BOOTSTRAP_DUAL_MASTER_APPROVAL=true

# Master primário (assento 1) — nasce com troca de senha obrigatória; TOTP e senha financeira
# são configurados no primeiro acesso. DESENVOLVIMENTO: endereço .localhost cai no Mailpit
# (http://127.0.0.1:8025); em produção use um e-mail real (domínios reservados são recusados).
RD_BOOTSTRAP_MASTER_EMAIL=master.dev@rd-midiaindoor.localhost
RD_BOOTSTRAP_MASTER_NAME=Administrador Master
