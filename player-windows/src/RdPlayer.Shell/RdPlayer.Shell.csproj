<Project Sdk="Microsoft.NET.Sdk">
  <!-- Casca WinForms + WebView2 que hospeda o bundle do web player (ADR_008 item 2). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RdPlayer.Shell</AssemblyName>
    <RootNamespace>RdPlayer.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- WinForms não suporta trimming (NETSDK1175); single-file com compressão reduz o tamanho do self-contained. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RdPlayer.Core\RdPlayer.Core.csproj" />
  </ItemGroup>
  <!-- O pacote WebView2 sempre referencia também os controles WPF/WinForms; a casca usa só o
       Microsoft.Web.WebView2.Core (controlador direto) → remove as referências desnecessárias (evita conflito WindowsBase). -->
  <Target Name="RdDropUnusedWebView2Controls" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
  <!-- Self-contained: o runtime pack WindowsDesktop traz WPF inteiro (~45 MB) e assemblies de designer, que a casca
       WinForms não carrega. Remove-os do pacote (WinForms não referencia WPF). Validado pelo teste de fumaça. -->
  <PropertyGroup>
    <_RdExcludedRuntimeFiles>;PresentationCore;PresentationFramework;PresentationFramework-SystemCore;PresentationFramework-SystemData;PresentationFramework-SystemDrawing;PresentationFramework-SystemXml;PresentationFramework-SystemXmlLinq;PresentationFramework.Aero;PresentationFramework.Aero2;PresentationFramework.AeroLite;PresentationFramework.Classic;PresentationFramework.Luna;PresentationFramework.Royale;PresentationNative_cor3;PresentationUI;ReachFramework;System.Printing;System.Windows.Controls.Ribbon;System.Windows.Input.Manipulations;System.Windows.Presentation;System.Xaml;UIAutomationClient;UIAutomationClientSideProviders;UIAutomationProvider;UIAutomationTypes;WindowsBase;WindowsFormsIntegration;DirectWriteForwarder;PenImc_cor3;wpfgfx_cor3;D3DCompiler_47_cor3;System.Windows.Forms.Design;System.Windows.Forms.Design.Editors;System.Drawing.Design;System.Design;Microsoft.VisualBasic.Forms;</_RdExcludedRuntimeFiles>
  </PropertyGroup>
  <Target Name="RdExcludeWpfFromRuntimePack" AfterTargets="ResolveRuntimePackAssets" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(RuntimePackAsset.NuGetPackageId)' == 'Microsoft.WindowsDesktop.App.Runtime.$(RuntimeIdentifier)' And $([System.String]::Copy('$(_RdExcludedRuntimeFiles)').Contains(';%(Filename);'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Microsoft.WindowsDesktop.App.Runtime.$(RuntimeIdentifier)' And $([System.String]::Copy('$(_RdExcludedRuntimeFiles)').Contains(';%(Filename);'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- página de diagnóstico própria da casca (host virtual https://shell.rd.local/) -->
    <None Include="shell-ui\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
