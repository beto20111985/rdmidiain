    {
      "type": "timeseries",
      "title": "Requisições por status",
      "id": 9,
      "datasource": {
        "type": "loki",
        "uid": "rd-loki"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "rd-loki"
          },
          "expr": "sum by (status) (count_over_time({compose_service=\"nginx\"} | json | __error__=\"\" [$__auto]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
