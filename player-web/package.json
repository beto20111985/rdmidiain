  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/qrcode": "1.5.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "25.0.1",
    "typescript": "~5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
