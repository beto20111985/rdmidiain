{
  "name": "rd-player-web",
  "private": true,
  "version": "1.0.0",
  "description": "RD Mídia Indoor — Web Player (RDPP/1). Núcleo TypeScript compartilhado com a casca Windows (WebView2).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
